# Copy to .env and adapt per machine.
#
# Diego laptop:
#   MAIN_MOUNT_VOLUME=/home/diego/Documents/02-Universidad/Cirtesu
#   DEPTH_ANYTHING_3_CONTEXT=/home/diego/Documents/02-Universidad/Cirtesu/Repositories/Depth-Anything-3
#   CONTAINER_USER=diego
#   CONTAINER_UID=1000
#   CONTAINER_GID=1000
#
# Cirtesu GPU workstation:
#   MAIN_MOUNT_VOLUME=/home/usuario/depth_anything_ws
#   DEPTH_ANYTHING_3_CONTEXT=/home/usuario/depth_anything_ws/src/Depth-Anything-3
#   CONTAINER_USER=usuario
#   CONTAINER_UID=1000
#   CONTAINER_GID=1000

# HOST AND CONTAINER PATHS
MAIN_MOUNT_VOLUME=/home/usuario/depth_anything_ws
CONTAINER_WORKSPACE=/home/usuario/depth_anything_ws
HOST_XAUTHORITY=/run/user/1000/gdm/Xauthority

# LOCAL DA3 FOLDER in HOST
DEPTH_ANYTHING_3_CONTEXT=/home/usuario/depth_anything_ws/src/Depth-Anything-3

# LOCAL ZED PERSISTENT DATA FOLDER in HOST
ZED_DATA_VOLUME=/home/usuario/zed_docker_data

# CONTAINER USER
CONTAINER_USER=usuario
CONTAINER_UID=1000
CONTAINER_GID=1000

# ZED SDK installer used by ros2-da3-zed-dev.
# Stereolabs release URLs use major/minor SDK and CUDA major, e.g.
# ZED SDK / CUDA
ZED_SDK_VERSION=5.2.3
ZED_CUDA_MAJOR=12
ZED_UBUNTU_MAJOR=22
CUDA_TOOLKIT_PKG=cuda-toolkit-12-4
ZED_ROS2_WRAPPER_REF=v5.2.2
